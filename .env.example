# NobleBlocks MCP Server Configuration
# =====================================

# API endpoint (default: production)
NOBLEBLOCKS_API_BASE=https://www.nobleblocks.com

# Your NobleBlocks API key (required for full access)
# Sign up free: https://www.nobleblocks.com/auth/signup
# Generate key: https://www.nobleblocks.com/settings/api-keys
# Without a key, you get 3 trial queries then must register.
NOBLEBLOCKS_API_KEY=

# Rate limiting (only applies with a valid key)
RATE_LIMIT_FREE=100        # daily limit (free key)
RATE_LIMIT_PRO=5000        # daily limit (pro key)
RATE_LIMIT_PER_MINUTE=60   # per-minute throttle
RATE_LIMIT_TRIAL=3         # queries before key required

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
