# NobleBlocks MCP Server Configuration
# =====================================

# API endpoint (default: production)
NOBLEBLOCKS_API_BASE=https://www.nobleblocks.com

# Your NobleBlocks API key (Pro tier)
# Get one at: https://www.nobleblocks.com/settings/api-keys
# Leave empty for free tier (100 searches/day)
NOBLEBLOCKS_API_KEY=

# Rate limiting
RATE_LIMIT_FREE=100        # daily limit without key
RATE_LIMIT_PRO=5000        # daily limit with key
RATE_LIMIT_PER_MINUTE=60   # per-minute throttle

# Audit log (JSON-L format)
AUDIT_LOG_FILE=/tmp/nobleblocks-mcp-audit.jsonl

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
